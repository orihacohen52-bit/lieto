<section style="min-height:80vh;display:grid;place-items:center;text-align:center;padding:40px 16px">
  <div style="max-width:460px;display:grid;gap:16px">
    <div class="logo" style="font-size:2.4rem">{{ shop.name | upcase }}</div>
    <h1 style="font-size:1.8rem">{{ section.settings.heading | escape }}</h1>
    <p style="color:var(--muted);margin:0">{{ section.settings.text | escape }}</p>
    {%- form 'customer' -%}
      <input type="hidden" name="contact[tags]" value="prelaunch">
      {%- if form.posted_successfully? -%}<p class="okmsg">{{ 'newsletter.thanks' | t }}</p>{%- else -%}
      <div style="display:flex;gap:8px"><label class="sr" for="pe">{{ 'newsletter.email' | t }}</label><input class="field" id="pe" type="email" name="contact[email]" placeholder="{{ 'newsletter.email' | t }}" required style="flex:1"><button class="btn btn-ink" type="submit">{{ 'newsletter.notify' | t }}</button></div>
      {%- endif -%}
    {%- endform -%}
    <details><summary style="cursor:pointer;color:var(--muted)">{{ 'general.owner_login' | t }}</summary>
      {%- form 'storefront_password' -%}{{ form.errors | default_errors }}
        <div style="display:flex;gap:8px;margin-top:10px"><label class="sr" for="pw">Password</label><input class="field" id="pw" type="password" name="password" style="flex:1"><button class="btn btn-line" type="submit">{{ 'general.enter' | t }}</button></div>
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{
  "name": "עמוד סיסמה",
  "settings": [
    { "type": "text", "id": "heading", "label": "כותרת", "default": "LIETO לגברים — נפתחים בקרוב" },
    { "type": "text", "id": "text", "label": "טקסט", "default": "תכשיטי גברים בגימור חד ובלי תג מחיר מנופח. השאר מייל לקבלת עדכון והטבת השקה." }
  ]
}
{% endschema %}
