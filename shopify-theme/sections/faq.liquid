<section class="blk faq" id="faq" style="padding-top:0" {{ section.shopify_attributes }}>
  <div class="wrap" style="max-width:860px">
    <div class="sec-h"><div>
      {%- if section.settings.eyebrow != blank -%}<div class="eyebrow">{{ section.settings.eyebrow | escape }}</div>{%- endif -%}
      <h2>{{ section.settings.heading | escape }}</h2>
    </div></div>
    {%- for block in section.blocks -%}
      <details {{ block.shopify_attributes }}><summary>{{ block.settings.q | escape }}</summary><div class="ans">{{ block.settings.a }}</div></details>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "שאלות נפוצות",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "כותרת קטנה", "default": "שאלות נפוצות" },
    { "type": "text", "id": "heading", "label": "כותרת", "default": "לפני שמזמינים" }
  ],
  "blocks": [
    { "type": "qa", "name": "שאלה", "settings": [
      { "type": "text", "id": "q", "label": "שאלה", "default": "כמה זמן לוקח המשלוח?" },
      { "type": "richtext", "id": "a", "label": "תשובה", "default": "<p>בדרך כלל בין 10 ל-25 ימי עסקים. מספר מעקב נשלח אליכם ברגע שהחבילה יוצאת.</p>" } ] }
  ],
  "presets": [{
    "name": "שאלות נפוצות",
    "blocks": [
      { "type": "qa", "settings": { "q": "כמה זמן לוקח המשלוח?", "a": "<p>בדרך כלל בין 10 ל-25 ימי עסקים. מספר מעקב נשלח אליכם ברגע שהחבילה יוצאת.</p>" } },
      { "type": "qa", "settings": { "q": "איך מבטלים או מחזירים?", "a": "<p>אפשר לבטל עד 14 ימים מקבלת המוצר, כמפורט במדיניות ההחזרות. פנו אלינו ונחזור אליכם.</p>" } },
      { "type": "qa", "settings": { "q": "האם התשלום מאובטח?", "a": "<p>כן. התשלום מתבצע בדף מאובטח, ופרטי האשראי לא נשמרים אצלנו.</p>" } },
      { "type": "qa", "settings": { "q": "ממה עשויים התכשיטים? האם זה זהב או כסף אמיתי?", "a": "<p>שקיפות מלאה: התכשיטים של LIETO הם תכשיטי אופנה לגברים — לא זהב אמיתי ולא כסף סטרלינג. אנחנו בוחרים פריטים מסגסוגות איכותיות ופלדת אל-חלד בגימור מטאלי (גוון כסוף, זהוב או שחור) כדי לתת לוק חד ונוכחות יוקרתית במחיר נגיש ליומיום. הרכב החומר המדויק מופיע בדף של כל מוצר.</p>" } },
      { "type": "qa", "settings": { "q": "יש מכס או עלויות נוספות?", "a": "<p>בהזמנות תכשיטים קטנות בדרך כלל אין תשלום נוסף. החיוב, אם יש, נקבע לפי החוק.</p>" } }
    ]
  }]
}
{% endschema %}
