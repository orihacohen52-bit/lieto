{%- paginate collection.products by section.settings.per_page -%}
<section class="blk" style="padding-top:110px">
  <div class="wrap">
    <div class="sec-h"><div>
      <h1 style="font-size:clamp(1.8rem,3.4vw,2.6rem);font-weight:400">{{ collection.title | escape }}</h1>
      {%- if collection.description != blank -%}<div style="color:var(--muted)">{{ collection.description }}</div>{%- endif -%}
    </div></div>
    <div class="tools">
      {%- if section.settings.menu != blank -%}
        <nav class="chips" aria-label="{{ 'collections.filter' | t }}">
          {%- for link in linklists[section.settings.menu].links -%}
            <a class="chip" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
          {%- endfor -%}
        </nav>
      {%- endif -%}
      {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
      <form method="get">
        <label class="sr" for="sort">{{ 'collections.sort' | t }}</label>
        <select class="field" id="sort" name="sort_by" onchange="this.form.submit()">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name | escape }}</option>
          {%- endfor -%}
        </select>
      </form>
    </div>
    <div class="grid">
      {%- for product in collection.products -%}
        {% render 'product-card', product: product %}
      {%- else -%}
        <div class="empty" style="grid-column:1/-1">{{ 'collections.empty' | t }}</div>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}
      <nav class="pager" aria-label="{{ 'collections.pages' | t }}">
        {%- if paginate.previous -%}<a class="btn btn-line btn-sm" href="{{ paginate.previous.url }}">{{ 'collections.prev' | t }}</a>{%- endif -%}
        {%- if paginate.next -%}<a class="btn btn-line btn-sm" href="{{ paginate.next.url }}">{{ 'collections.next' | t }}</a>{%- endif -%}
      </nav>
    {%- endif -%}
  </div>
</section>
{%- endpaginate -%}

{% schema %}
{
  "name": "עמוד אוסף",
  "settings": [
    { "type": "range", "id": "per_page", "label": "מוצרים בעמוד", "min": 8, "max": 48, "step": 4, "default": 24 },
    { "type": "link_list", "id": "menu", "label": "כפתורי קטגוריות (תפריט)" }
  ]
}
{% endschema %}
