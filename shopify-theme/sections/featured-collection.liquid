{%- assign c = section.settings.collection -%}
<section class="blk" id="collection" {{ section.shopify_attributes }}>
  <div class="wrap">
    <div class="sec-h"><div>
      {%- if section.settings.eyebrow != blank -%}<div class="eyebrow">{{ section.settings.eyebrow | escape }}</div>{%- endif -%}
      <h2>{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
    </div>
    {%- if c != blank -%}<a class="txtlink" href="{{ c.url }}">{{ 'general.view_all' | t }}</a>{%- endif -%}
    </div>
    <div class="grid">
      {%- if c != blank and c.products_count > 0 -%}
        {%- for product in c.products limit: section.settings.limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        <div class="empty" style="grid-column:1/-1">{{ 'collections.empty' | t }}</div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "מוצרים מאוסף",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "כותרת קטנה", "default": "קולקציית הגברים" },
    { "type": "text", "id": "heading", "label": "כותרת", "default": "תכשיטים שעושים את הלוק" },
    { "type": "text", "id": "text", "label": "טקסט", "default": "גימור מטאלי חד לגברים · משלוח חינם מעל ₪199 · 14 יום להחזרה" },
    { "type": "collection", "id": "collection", "label": "אוסף" },
    { "type": "range", "id": "limit", "label": "מספר מוצרים", "min": 4, "max": 24, "step": 4, "default": 12 }
  ],
  "presets": [{ "name": "מוצרים מאוסף" }]
}
{% endschema %}
