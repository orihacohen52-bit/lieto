{%- assign current = product.selected_or_first_available_variant -%}
<div class="wrap">
  <div class="pd">
    <div class="gal">
      <div class="gal-stage" id="galStage">
        {%- assign first = product.media | first -%}
        {%- if first and first.media_type == 'image' -%}
          {{ first | image_url: width: 1200 | image_tag: alt: product.title, loading: 'eager', widths: '600, 900, 1200', sizes: '(max-width: 760px) 100vw, 55vw' }}
        {%- elsif first == blank -%}
          {{ 'product-1' | placeholder_svg_tag }}
        {%- endif -%}
      </div>
      {%- if product.media.size > 1 -%}
        <div class="gal-thumbs">
          {%- for m in product.media -%}
            <button class="gal-th" type="button" data-media="{{ m.id }}" data-type="{{ m.media_type }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="{% if m.media_type == 'video' %}{{ 'products.video' | t }}{% else %}{{ 'products.image' | t }}{% endif %} {{ forloop.index }}">
              {{ m.preview_image | image_url: width: 140 | image_tag: alt: '', loading: 'lazy' }}
              {%- if m.media_type == 'video' or m.media_type == 'external_video' -%}<span class="play" aria-hidden="true">▶</span>{%- endif -%}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
      {%- for m in product.media -%}
        <template id="gal-{{ m.id }}">
          {%- case m.media_type -%}
            {%- when 'image' -%}{{ m | image_url: width: 1200 | image_tag: alt: product.title, widths: '600, 900, 1200' }}
            {%- when 'video' -%}{{ m | video_tag: muted: true, loop: true, playsinline: true, preload: 'auto', image_size: '1200x' }}
            {%- when 'external_video' -%}{{ m | external_video_tag }}
            {%- else -%}{{ m.preview_image | image_url: width: 1200 | image_tag: alt: product.title }}
          {%- endcase -%}
        </template>
      {%- endfor -%}
    </div>

    <div class="pd-i">
      {%- assign col = product.collections | first -%}
      {%- if col -%}<a class="eyebrow" href="{{ col.url }}" style="text-decoration:none">{{ col.title | escape }}</a>{%- endif -%}
      <h1>{{ product.title | escape }}</h1>
      <div class="pd-price" data-price>{% render 'price', variant: current %}</div>
      {%- if section.settings.promo_note != blank -%}<div class="promo-note">{{ section.settings.promo_note }}</div>{%- endif -%}

      {%- form 'product', product, class: 'pd-form', data-ajax-cart: '' -%}
        <input type="hidden" name="id" value="{{ current.id }}">
        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <fieldset class="opts" data-opt>
              <legend>{{ option.name | escape }}</legend>
              {%- for value in option.values -%}
                <label class="opt"><input type="radio" name="opt-{{ forloop.parentloop.index }}" value="{{ value | escape }}"{% if option.selected_value == value %} checked{% endif %}><span>{{ value | escape }}</span></label>
              {%- endfor -%}
            </fieldset>
          {%- endfor -%}
        {%- endunless -%}
        <div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin-top:6px">
          <div class="qty"><button type="button" data-qty="-1" aria-label="{{ 'cart.less' | t }}">−</button><input type="number" name="quantity" value="1" min="1" max="99" aria-label="{{ 'cart.quantity' | t }}"><button type="button" data-qty="1" aria-label="{{ 'cart.more' | t }}">+</button></div>
          <button class="btn btn-ink" type="submit" style="flex:1;min-width:200px" data-add="{{ 'products.add' | t }}" data-soldout="{{ 'products.sold_out' | t }}" data-unavailable="{{ 'products.unavailable' | t }}"{% unless current.available %} disabled{% endunless %}>{%- if current.available -%}{{ 'products.add' | t }}{%- else -%}{{ 'products.sold_out' | t }}{%- endif -%}</button>
        </div>
        <script type="application/json" data-variants>
          [{%- for v in product.variants -%}{%- capture ph -%}{% render 'price', variant: v %}{%- endcapture -%}{"id":{{ v.id }},"available":{{ v.available | json }},"options":{{ v.options | json }},"price_html":{{ ph | strip | json }}}{% unless forloop.last %},{% endunless %}{%- endfor -%}]
        </script>
        {{ form | payment_terms }}
      {%- endform -%}

      {%- if product.description != blank -%}<div class="rte">{{ product.description }}</div>{%- endif -%}
      <dl class="spec">
        {%- if product.metafields.custom.material != blank -%}<dt>{{ 'products.material' | t }}</dt><dd>{{ product.metafields.custom.material | escape }}</dd>{%- endif -%}
        <dt>{{ 'products.delivery' | t }}</dt><dd>{{ section.settings.delivery | escape }}</dd>
        <dt>{{ 'products.returns' | t }}</dt><dd>{{ section.settings.returns | escape }}</dd>
      </dl>
    </div>
  </div>
</div>
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": {{ product.title | json }},
  "url": {{ request.origin | append: product.url | json }},
  {%- if product.featured_image -%}"image": [{{ product.featured_image | image_url: width: 1200 | prepend: 'https:' | json }}],{%- endif -%}
  "description": {{ product.description | strip_html | json }},
  "offers": [{%- for v in product.variants -%}{"@type":"Offer","price":{{ v.price | divided_by: 100.0 | json }},"priceCurrency":{{ cart.currency.iso_code | json }},"availability":"https://schema.org/{% if v.available %}InStock{% else %}OutOfStock{% endif %}","url":{{ request.origin | append: v.url | json }}}{% unless forloop.last %},{% endunless %}{%- endfor -%}]
}
</script>

{% schema %}
{
  "name": "עמוד מוצר",
  "settings": [
    { "type": "inline_richtext", "id": "promo_note", "label": "הודעת מבצע (לא חובה)", "default": "מבצע השקה: <b>15% הנחה</b> על כל ההזמנה עם הקוד <b>LAUNCH15</b>" },
    { "type": "text", "id": "delivery", "label": "זמן אספקה", "default": "10 עד 25 ימי עסקים, עם מספר מעקב" },
    { "type": "text", "id": "returns", "label": "החזרה", "default": "14 יום להחזרה, לפי התקנון" }
  ]
}
{% endschema %}
