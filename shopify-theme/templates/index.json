    "faq": {
      "type": "faq",
      "blocks": {
        "q1": {
          "type": "qa",
          "settings": {
            "q": "כמה זמן לוקח המשלוח?",
            "a": "<p>זמן האספקה הוא בדרך כלל 10 עד 25 ימי עסקים. ברגע שהחבילה יוצאת לדרך נשלח אליך מספר מעקב למייל.</p>"
          }
        },
        "q2": {
          "type": "qa",
          "settings": {
            "q": "איך מבטלים או מחזירים?",
            "a": "<p>אפשר לבטל או להחזיר עד 14 ימים מקבלת המוצר, כמפורט במדיניות ההחזרות. פנה אלינו ונחזור אליך במהירות.</p>"
          }
        },
        "q3": {
          "type": "qa",
          "settings": {
            "q": "האם התשלום מאובטח?",
            "a": "<p>כן. התשלום מתבצע בעמוד סליקה מאובטח ומוצפן, ופרטי האשראי לא נשמרים אצלנו.</p>"
          }
        },
        "q4": {
          "type": "qa",
          "settings": {
            "q": "ממה עשויים התכשיטים? האם זה זהב או כסף אמיתי?",
            "a": "<p>שקיפות מלאה: התכשיטים של LIETO הם תכשיטי אופנה לגברים — לא זהב אמיתי ולא כסף סטרלינג. אנחנו בוחרים פריטים מסגסוגות איכותיות ופלדת אל-חלד בגימור מטאלי (גוון כסוף, זהוב או שחור) כדי לתת לוק חד ונוכחות יוקרתית במחיר נגיש ליומיום. הרכב החומר המדויק מופיע בדף של כל מוצר.</p>"
          }
        },
        "q5": {
          "type": "qa",
          "settings": {
            "q": "יש מכס או עלויות נוספות?",
            "a": "<p>בהזמנות תכשיטים בסכומים רגילים בדרך כלל אין תשלום נוסף. אם חל חיוב כלשהו, הוא נקבע על ידי רשות המיסים לפי החוק.</p>"
          }
        }
      },
