<div class="wrap page" style="padding-top:110px;max-width:520px">
  <h1>{{ 'customer.activate' | t }}</h1>
  {%- form 'activate_customer_password' -%}
    {{ form.errors | default_errors }}
    <div style="display:grid;gap:12px">
      <label for="ap">{{ 'customer.password' | t }}</label><input class="field" id="ap" type="password" name="customer[password]" autocomplete="new-password" required>
      <label for="apc">{{ 'customer.password_confirm' | t }}</label><input class="field" id="apc" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
      <button class="btn btn-ink" type="submit">{{ 'customer.activate' | t }}</button>
    </div>
  {%- endform -%}
</div>
