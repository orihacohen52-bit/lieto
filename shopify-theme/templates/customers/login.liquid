<div class="wrap page" style="padding-top:110px;max-width:520px">
  <h1>{{ 'customer.login' | t }}</h1>
  {%- form 'customer_login' -%}
    {{ form.errors | default_errors }}
    <div style="display:grid;gap:12px">
      <label for="le">{{ 'customer.email' | t }}</label><input class="field" id="le" type="email" name="customer[email]" autocomplete="email" required>
      <label for="lp">{{ 'customer.password' | t }}</label><input class="field" id="lp" type="password" name="customer[password]" autocomplete="current-password" required>
      <button class="btn btn-ink" type="submit">{{ 'customer.login' | t }}</button>
      <a href="{{ routes.account_register_url }}">{{ 'customer.register' | t }}</a>
    </div>
  {%- endform -%}
  {%- form 'recover_customer_password' -%}
    {{ form.errors | default_errors }}
    {%- if form.posted_successfully? -%}<p class="okmsg">{{ 'customer.recover_sent' | t }}</p>{%- endif -%}
    <div style="display:grid;gap:12px;margin-top:30px">
      <label for="re">{{ 'customer.forgot' | t }}</label><input class="field" id="re" type="email" name="email" autocomplete="email" required>
      <button class="btn btn-line" type="submit">{{ 'customer.reset' | t }}</button>
    </div>
  {%- endform -%}
</div>
