<div class="wrap page" style="padding-top:110px;max-width:520px">
  <h1>{{ 'customer.register' | t }}</h1>
  {%- form 'create_customer' -%}
    {{ form.errors | default_errors }}
    <div style="display:grid;gap:12px">
      <label for="rf">{{ 'customer.first_name' | t }}</label><input class="field" id="rf" type="text" name="customer[first_name]" autocomplete="given-name">
      <label for="rl">{{ 'customer.last_name' | t }}</label><input class="field" id="rl" type="text" name="customer[last_name]" autocomplete="family-name">
      <label for="rem">{{ 'customer.email' | t }}</label><input class="field" id="rem" type="email" name="customer[email]" autocomplete="email" required>
      <label for="rp">{{ 'customer.password' | t }}</label><input class="field" id="rp" type="password" name="customer[password]" autocomplete="new-password" required>
      <button class="btn btn-ink" type="submit">{{ 'customer.register' | t }}</button>
    </div>
  {%- endform -%}
</div>
