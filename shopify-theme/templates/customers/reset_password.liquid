<div class="wrap page" style="padding-top:110px;max-width:520px">
  <h1>{{ 'customer.reset' | t }}</h1>
  {%- form 'reset_customer_password' -%}
    {{ form.errors | default_errors }}
    <div style="display:grid;gap:12px">
      <label for="np">{{ 'customer.password' | t }}</label><input class="field" id="np" type="password" name="customer[password]" autocomplete="new-password" required>
      <label for="npc">{{ 'customer.password_confirm' | t }}</label><input class="field" id="npc" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
      <button class="btn btn-ink" type="submit">{{ 'customer.reset' | t }}</button>
    </div>
  {%- endform -%}
</div>
